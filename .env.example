# Copiar este archivo como .env y completar los valores. El .env NUNCA se sube a git.

# En las dos cadenas de Neon, cambiar "sslmode=require" por "sslmode=verify-full"
# (es igual de seguro y evita un aviso del driver).

# Neon: cadena CON pooler (el host contiene "-pooler"). La usa la app.
DATABASE_URL=""

# Neon: cadena SIN pooler. La usan las migraciones de Prisma.
DIRECT_URL=""

# Secreto para firmar la cookie de sesión. Texto aleatorio largo (mínimo 32 caracteres).
SESSION_SECRET=""
