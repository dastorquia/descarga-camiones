// Esquema de la sección 4 de docs/ESPECIFICACION.md.
// Prisma 7: la conexión se define en prisma.config.ts (CLI) y en
// src/shared/lib/db.ts (app), no acá. Los modelos son los de la especificación.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoDescarga {
  EN_CURSO
  PAUSADA
  FINALIZADA
}

enum TipoOperacion {
  DESCARGA
  CARGA
}

model Descarga {
  id            Int            @id @default(autoincrement())
  hojaDeRuta    String         @unique
  tipo          TipoOperacion  @default(DESCARGA)
  patente       String?
  productoId    Int
  proveedorId   Int
  tanqueId      Int
  estado        EstadoDescarga @default(EN_CURSO)
  toneladas     Decimal?       @db.Decimal(10, 3)
  observaciones String?
  creadaEn      DateTime       @default(now())
  actualizadaEn DateTime       @updatedAt

  producto  Producto      @relation(fields: [productoId], references: [id])
  proveedor Proveedor     @relation(fields: [proveedorId], references: [id])
  tanque    Tanque        @relation(fields: [tanqueId], references: [id])
  tramos    TramoBombeo[]

  @@index([estado])
  @@index([creadaEn])
}

model TramoBombeo {
  id         Int       @id @default(autoincrement())
  descargaId Int
  bombaId    Int
  operarioId Int
  inicio     DateTime
  fin        DateTime?
  // Solo lo completa el Supervisor, en el caso excepcional de dos bombas.
  toneladas  Decimal?  @db.Decimal(10, 3)

  descarga Descarga @relation(fields: [descargaId], references: [id], onDelete: Cascade)
  bomba    Bomba    @relation(fields: [bombaId], references: [id])
  operario Operario @relation(fields: [operarioId], references: [id])

  @@index([bombaId, inicio])
  @@index([descargaId])
}

model Bomba {
  id          Int           @id @default(autoincrement())
  codigo      String        @unique
  // Se usa para el sector: "Descarga 1", "Descarga 2", "Descarga 3".
  descripcion String?
  activa      Boolean       @default(true)
  tramos      TramoBombeo[]
  // Relación agregada con MantenimientoBomba: no cambia la tabla Bomba.
  mantenimientos MantenimientoBomba[]
  // Relaciones agregadas el 29/10/2026 (movimientos internos y mantenimiento autónomo).
  movimientosCarga    MovimientoInterno[] @relation("BombaCarga")
  movimientosDescarga MovimientoInterno[] @relation("BombaDescarga")
  autonomo            BombaAutonomo?
  tareasAutonomas     TareaAutonoma[]
}

// Agregado el 29/10/2026 (migración aditiva): períodos en que una bomba estuvo
// en mantenimiento. Abierto (hasta = null) = la bomba no se puede elegir.
// La base impide dos mantenimientos abiertos de la misma bomba.
model MantenimientoBomba {
  id      Int       @id @default(autoincrement())
  bombaId Int
  desde   DateTime  @default(now())
  hasta   DateTime?
  motivo  String?

  bomba Bomba @relation(fields: [bombaId], references: [id])

  @@index([bombaId, desde])
}

model Tanque {
  id        Int        @id @default(autoincrement())
  codigo    String     @unique // formato TK-001, TK-012, TK-101
  activo    Boolean    @default(true)
  descargas Descarga[]
  movimientosOrigen  MovimientoInterno[] @relation("TanqueOrigen")
  movimientosDestino MovimientoInterno[] @relation("TanqueDestino")
}

model Producto {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  activo    Boolean    @default(true)
  descargas Descarga[]
}

model Proveedor {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  activo    Boolean    @default(true)
  descargas Descarga[]
}

model Operario {
  id     Int           @id @default(autoincrement())
  nombre String        @unique
  activo Boolean       @default(true)
  tramos TramoBombeo[]
  movimientos     MovimientoInterno[]
  tareasAutonomas TareaAutonoma[]
}

model Config {
  clave String @id
  valor String // por ejemplo: pinSupervisorHash, pinPorDefecto, umbrales
}

// Agregado en la Etapa 2 (migración aditiva): intentos fallidos de PIN,
// por dispositivo ("dispositivo:<id>") y por IP ("ip:<dirección>").
model IntentoPin {
  clave          String    @id
  fallidos       Int       @default(0)
  bloqueadoHasta DateTime?
  actualizadoEn  DateTime  @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @default(now())
  perfil    String // COLABORADOR | SUPERVISOR
  entidad   String
  entidadId Int
  accion    String // CREAR | EDITAR | DESACTIVAR ...
  antes     Json?
  despues   Json?
}

// Agregado el 29/10/2026 (migración aditiva): movimiento interno entre tanques.
// Se carga completo al terminar. Sus horas se suman a las de las dos bombas.
model MovimientoInterno {
  id              Int      @id @default(autoincrement())
  tanqueOrigenId  Int
  tanqueDestinoId Int
  toneladas       Decimal  @db.Decimal(10, 3)
  patente         String
  inicio          DateTime
  fin             DateTime
  bombaCargaId    Int
  bombaDescargaId Int
  operarioId      Int
  creadoEn        DateTime @default(now())

  tanqueOrigen  Tanque   @relation("TanqueOrigen", fields: [tanqueOrigenId], references: [id])
  tanqueDestino Tanque   @relation("TanqueDestino", fields: [tanqueDestinoId], references: [id])
  bombaCarga    Bomba    @relation("BombaCarga", fields: [bombaCargaId], references: [id])
  bombaDescarga Bomba    @relation("BombaDescarga", fields: [bombaDescargaId], references: [id])
  operario      Operario @relation(fields: [operarioId], references: [id])

  @@index([inicio])
}

enum TipoTareaAutonoma {
  INSPECCION_CUERPO
  INSPECCION_SKID
  LIMPIEZA
  AJUSTE_PRENSAESTOPAS
}

// Agregado el 29/10/2026: bombas que requieren mantenimiento autónomo (si hay fila, lo requiere).
model BombaAutonomo {
  bombaId Int   @id
  bomba   Bomba @relation(fields: [bombaId], references: [id])
}

// Registro de cada tarea de mantenimiento autónomo hecha.
model TareaAutonoma {
  id         Int               @id @default(autoincrement())
  bombaId    Int
  tarea      TipoTareaAutonoma
  operarioId Int
  fecha      DateTime
  // Agregado el 30/10/2026: comentario breve (hasta 200 caracteres).
  observaciones String?
  creadoEn   DateTime          @default(now())

  bomba    Bomba    @relation(fields: [bombaId], references: [id])
  operario Operario @relation(fields: [operarioId], references: [id])

  @@index([bombaId, tarea, fecha])
}
